# Used by `docker compose up` — copy to .env at this same path (repo root)
# and fill in real values before deploying. DB_HOST/REDIS_HOST/MINIO_ENDPOINT
# are overridden to the container service names (postgres/redis/minio)
# directly in docker-compose.yml, so their values here don't matter for the
# Docker deployment — they're only read when running the backend outside
# Docker (see apps/backend/.env.example for that workflow).

# Server
NODE_ENV=production

# Postgres
DB_HOST=postgres
DB_PORT=5432
DB_USERNAME=lc_app
DB_PASSWORD=CHANGE_ME_use_a_real_password
DB_NAME=learning_center

# Redis
REDIS_HOST=redis
REDIS_PORT=6379

# JWT — generate real random secrets, e.g. `openssl rand -hex 32`
JWT_ACCESS_SECRET=CHANGE_ME
JWT_ACCESS_TTL=15m
JWT_REFRESH_SECRET=CHANGE_ME
JWT_REFRESH_TTL=7d

# MinIO (object storage) — real credentials, not the S3RVER/minioadmin dev defaults
MINIO_ENDPOINT=minio
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_ACCESS_KEY=CHANGE_ME
MINIO_SECRET_KEY=CHANGE_ME
MINIO_BUCKET_AVATARS=avatars
MINIO_BUCKET_TASK_FILES=task-attachments
MINIO_BUCKET_CONTENT=content
MINIO_BUCKET_REPORTS=reports

# Telegram bot — can also be left blank and configured later by Full
# Administrator via PATCH /telegram/bot-config
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=

# Bootstrap Full Administrator (only used once, on a fresh install with no users)
BOOTSTRAP_ADMIN_EMAIL=admin@learningcenter.local
BOOTSTRAP_ADMIN_PASSWORD=CHANGE_ME
